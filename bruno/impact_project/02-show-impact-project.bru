meta {
  name: Show Impact Project
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/impact-projects/{{impact_project_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

docs {
  Exibe um projeto de impacto com a capa e o link de video (videoUrl, embed do
  YouTube ou do Vimeo; null quando nao ha video).
}
