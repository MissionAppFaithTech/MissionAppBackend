meta {
  name: Create Impact Project
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/impact-projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "title": "Escola na Comunidade",
    "description": "Construcao de uma escola comunitaria no interior.",
    "coverImageAssetId": "{{media_asset_id}}",
    "videoUrl": "https://youtu.be/dQw4w9WgXcQ"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("impact_project_id", res.getBody().data.impactProject.id);
  }
}

docs {
  Cria o projeto de impacto do missionario autenticado (um por missionario).
  A capa precisa ser um asset IMPACT_PROJECT_COVER enviado pelo proprio usuario
  e com upload confirmado. ADMIN deve informar missionaryId. O video e opcional e
  e so um link do YouTube ou do Vimeo (RF 9.2), guardado no formato de embed;
  outros links respondem 422.
}
