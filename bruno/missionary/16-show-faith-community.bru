meta {
  name: Show Faith Community
  type: http
  seq: 16
}

get {
  url: {{base_url}}/api/v1/faith-communities/{{faith_community_id}}
  auth: none
}

docs {
  Exibe os dados de uma comunidade de fe especifica por id.

  Consulta pública (sem autenticação), usada no cadastro de missionário
  antes de a conta existir. Limitada a 20 requisições por 60 segundos
  por IP (429 + Retry-After ao exceder).
}
