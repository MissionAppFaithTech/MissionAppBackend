meta {
  name: Update Missionary About
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/api/v1/missionaries/about
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "aboutMe": "Sou missionario em teste local",
    "missionStorySummary": "Resumo da historia missionaria",
    "originLocation": "Sao Paulo - SP",
    "prayerRequest": "Orar por sabedoria",
    "lifeVerse": "Joao 3:16",
    "missionaryAgencyId": "{{missionary_agency_id}}",
    "workAddress": {
      "zip": "24020-000",
      "district": "Centro",
      "city": "Niteroi",
      "state": "RJ",
      "country": "Brasil"
    }
  }
}

docs {
  Atualiza a secao de apresentacao do missionario autenticado.

  Atualizacao parcial: campos omitidos nao sao alterados; enviar `null` (ou
  string vazia) em qualquer campo limpa o valor salvo, exceto `missionaryAgencyId`
  (obrigatorio no perfil) e `workAddress` (substitui o endereco inteiro).
}
