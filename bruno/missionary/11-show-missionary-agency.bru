meta {
  name: Show Missionary Agency
  type: http
  seq: 11
}

get {
  url: {{base_url}}/api/v1/missionary-agencies/{{missionary_agency_id}}
  auth: none
}

docs {
  Exibe os dados de uma agencia missionaria especifica por id.

  Consulta pública (sem autenticação), usada no cadastro de missionário
  antes de a conta existir. Limitada a 20 requisições por 60 segundos
  por IP (429 + Retry-After ao exceder).
}
