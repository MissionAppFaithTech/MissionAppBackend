meta {
  name: Show Donation Settings
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/missionaries/donation-settings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

docs {
  Area de doacao do proprio missionario (RF 12.1), em claro e com o status de
  cada metodo: ACTIVE quando configurado, PENDING quando nao (RF 12.1.4).
}
