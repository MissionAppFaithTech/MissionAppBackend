SESSION_DRIVER=memory

# NOTE: banco lógico separado no Dragonfly — um `queue:workers` rodando em
# desenvolvimento (banco 0) não consome os jobs que os testes inspecionam.
REDIS_DB=1

# NOTE: valores fictícios — o R2 nunca é acessado nos testes; servem só para
# verificar a configuração dos discos r2_* em tests/unit/config/drive.spec.ts.
R2_ENDPOINT=https://test-account.r2.cloudflarestorage.com
R2_ACCESS_KEY=test-r2-access-key
R2_SECRET_KEY=test-r2-secret-key
R2_PUBLIC_BUCKET=missionapp-test-public-assets
R2_PRIVATE_BUCKET=missionapp-test-private-docs
R2_PUBLIC_URL=https://assets.test.example
